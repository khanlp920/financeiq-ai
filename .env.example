# ── Supabase (required for auth + persistence) ────────────────────────────────
# Without these, the app runs in fully-functional Demo Mode (localStorage).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Anthropic (optional — powers AI chat + AI categorization refinement) ─────
# Without it, chat falls back to the built-in deterministic financial engine.
ANTHROPIC_API_KEY=sk-ant-...
